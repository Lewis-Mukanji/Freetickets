# ---- Admin ----
# The one password for the admin dashboard
ADMIN_PASSWORD=change-me
# Any long random text (used to sign the admin login cookie)
SESSION_SECRET=replace-with-a-long-random-string

# ---- Tickets ----
MAX_TICKETS=120

# ---- Database ----
# Leave empty locally (uses a file called local.db).
# In production, use your Turso database URL + token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---- Email (SMTP) ----
# Gmail example: host smtp.gmail.com, port 465, user = the gmail address,
# pass = a 16-character Google "App Password" (not your normal password).
# If SMTP_HOST is empty, emails are saved to the "outbox" folder instead (for testing).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hair by Akose Festival <yourgmail@gmail.com>"
